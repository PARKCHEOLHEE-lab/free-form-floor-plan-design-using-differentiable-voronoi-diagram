// Python dev container — original config, now one of two selectable
// configurations under .devcontainer/ (VS Code shows a picker on
// "Dev Containers: Reopen in Container"). Sibling: ../rust/devcontainer.json
//
// `context` points at the python package dir so the Dockerfile can COPY
// requirements.txt; `dockerfile` is resolved relative to this folder.
{
    "name": "voronoi-floorplan-python",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../../free_form_floor_plan_design_using_differentiable_voronoi_diagram/python"
    },
    // No host bind mounts for gitconfig/ssh on purpose: VS Code copies the
    // local .gitconfig into the container and forwards the running SSH agent
    // automatically. That works on Windows/macOS/Linux without hardcoding a
    // home path (no single env var covers all three) or a key filename (a
    // bind mount of a missing ~/.ssh/id_rsa would block the container start).
    "customizations": {
        "vscode": {
            "settings": {
                "editor.wordWrap": "wordWrapColumn",
                "editor.wordWrapColumn": 120,
                "terminal.integrated.shell.linux": "/bin/zsh"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "mhutchie.git-graph",
                "ms-python.debugpy",
                "hediet.debug-visualizer",
                "Meezilla.json",
                "njpwerner.autodocstring",
                "ms-azuretools.vscode-docker",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/python/post-create-command.sh",
    "remoteUser": "root"
}
